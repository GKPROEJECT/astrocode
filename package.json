{
  "name": "astrocode",
  "displayName": "AstroCode",
  "publisher": "AstroCode",
  "description": "%extension.description%",
  "version": "1.2.5",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Programming Languages"
  ],
  "keywords": [
    "screenshot",
    "code",
    "capture",
    "beauty",
    "shiki",
    "export"
  ],
  "license": "MIT",
  "main": "./dist/extension.js",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/GKPROEJECT/astrocode"
  },
  "bugs": {
    "url": "https://github.com/GKPROEJECT/astrocode/issues"
  },
  "homepage": "https://github.com/GKPROEJECT/astrocode#readme",
  "contributes": {
    "commands": [
      {
        "command": "astrocode.captureSelection",
        "title": "%command.captureSelection%"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "shiki": "^4.0.2"
  }
}
